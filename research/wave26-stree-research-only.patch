+#define SHOT_FLOOR(v) (((v < 0.0f && (int)v != v) != 0) ? v - 1.0f : v)
+/* 0x80045E24 */
+surftyp *ShotToWorldCollision(float *old, float *new, float (*uvs)[3], float radius, int interp, int ignore)
+{
+    float tuvs[3][3];
+    unsigned int i;
+    signed short quad0, quad1;
+    int sli;
+    float radiussq, t;
+    float ipos[3], opos[3], epos[3];
+    unsigned short snum, path, spath, slnum[35];
+    signed short midh, midv;
+    int state;
+    unsigned char *slp;
+    streetyp *ltp0, *ltp1;
+    surftyp *sp, *savesp = 0;
+    float x, z;
+    ipos[0] = old[0]; ipos[1] = old[1]; ipos[2] = old[2];
+    z = floorpos(ipos[2]);
+    x = floorpos(ipos[0]);
+    ltp0 = updownleaf(stree, x, z, &quad0);
+    if (!ltp0) return 0;
+    z = floorpos(new[2]);
+    x = floorpos(new[0]);
+    ltp1 = updownleaf(stree, x, z, &quad1);
+    radiussq = radius * radius;
+    do {
+        signed short maxh, maxv; int minv, minh;
+        float dx, dy, dz;
+        minh = ltp0->minh;
+        midh = minh + ltp0->maxh;
+        if (midh < 0) midh++;
+        minv = ltp0->minv;
+        maxv = ltp0->maxv;
+        midv = minv + maxv;
+        if (midv < 0) midv++;
+        midh >>= 1;
+        midv >>= 1;
+        maxh = midh;
+        minv = midv;
+        if (quad0 & 1) minh = midh;
+        if (quad0 & 1) maxh = ltp0->maxh;
+        maxv = (quad0 & 2) ? midv : maxv;
+        if (quad0 & 2) minv = ltp0->minv;
+        sli = ltp0->child[quad0];
+        if (ltp0->flags & (16 << quad0)) sli |= 0x10000;
+        if (sli) {
+            slp = slist + sli;
+            snum = *slp++;
+            DecodeSlist(slp, snum, slnum, -1);
+            for (i = 0; i < snum; i++) {
+                sp = &surf[slnum[i]];
+                if ((sp->flags & 15) == 15 || (sp->flags & 15) == ignore) continue;
+                state = CylinderInSurf(sp, ipos, new, opos, epos, tuvs, radiussq, 0, &path);
+                if (state) {
+                    if (opos[0] < (signed short)minh || opos[0] >= maxh || opos[2] < (signed short)minv || opos[2] >= maxv) continue;
+                    new[0] = opos[0]; new[1] = opos[1]; new[2] = opos[2];
+                    CopyUV(tuvs, uvs);
+                    savesp = sp;
+                    spath = path;
+                }
+            }
+        }
+        if (savesp) {
+            if (interp) {
+                if (savesp->flags & 0x2000) fHalfPipeInterp(savesp, spath, new, epos, uvs, 250.0f);
+                else if (savesp->flags & 0x1000) {
+                    fPathInterp(savesp, spath, new, epos, uvs);
+                    NormalVector(uvs[0]); NormalVector(uvs[1]); NormalVector(uvs[2]);
+                }
+            }
+            return savesp;
+        }
+        if (ltp0 == ltp1 && quad0 == quad1) return 0;
+        dx = new[0] - ipos[0];
+        dy = new[1] - ipos[1];
+        dz = new[2] - ipos[2];
+        if (dx < 0.0f) {
+            opos[0] = (signed short)minh;
+            t = (opos[0] - ipos[0]) / dx;
+            opos[2] = ipos[2] + t * dz;
+            opos[1] = ipos[1] + t * dy;
+            if ((signed short)minv == opos[2] && dz < 0.0f) {
+                ltp0 = updownleaf(stree, minh - 1, minv - 1, &quad0);
+                goto next;
+            } else if (maxv == opos[2] && dz < 0.0f) {
+                ltp0 = updownleaf(stree, minh - 1, maxv - 1, &quad0);
+                goto next;
+            } else if ((signed short)minv <= opos[2] && opos[2] <= maxv) {
+                ltp0 = updownleaf(stree, minh - 1, SHOT_FLOOR(opos[2]), &quad0);
+                goto next;
+            }
+        } else if (dx > 0.0f) {
+            opos[0] = maxh;
+            t = (opos[0] - ipos[0]) / dx;
+            opos[2] = ipos[2] + t * dz;
+            opos[1] = ipos[1] + t * dy;
+            if ((signed short)minv == opos[2] && dz < 0.0f) {
+                ltp0 = updownleaf(stree, maxh, minv - 1, &quad0);
+                goto next;
+            } else if (maxv == opos[2] && dz < 0.0f) {
+                ltp0 = updownleaf(stree, maxh, maxv - 1, &quad0);
+                goto next;
+            } else if ((signed short)minv <= opos[2] && opos[2] <= maxv) {
+                ltp0 = updownleaf(stree, maxh, SHOT_FLOOR(opos[2]), &quad0);
+                goto next;
+            }
+        }
+        if (dz < 0.0f) {
+            opos[2] = (signed short)minv;
+            t = (opos[2] - ipos[2]) / dz;
+            opos[1] = ipos[1] + t * dy;
+            opos[0] = ipos[0] + t * dx;
+            if ((signed short)minh == opos[0] && dx < 0.0f) {
+                ltp0 = updownleaf(stree, minh - 1, minv - 1, &quad0);
+                goto next;
+            } else if (maxh == opos[0] && dx < 0.0f) {
+                ltp0 = updownleaf(stree, maxh - 1, minv - 1, &quad0);
+                goto next;
+            } else if ((signed short)minh <= opos[0] && opos[0] <= maxh) {
+                ltp0 = updownleaf(stree, SHOT_FLOOR(opos[0]), minv - 1, &quad0);
+                goto next;
+            }
+        } else if (dz > 0.0f) {
+            opos[2] = maxv;
+            t = (opos[2] - ipos[2]) / dz;
+            opos[1] = ipos[1] + t * dy;
+            opos[0] = ipos[0] + t * dx;
+            if ((signed short)minh == opos[0] && dx < 0.0f) {
+                ltp0 = updownleaf(stree, minh - 1, maxv, &quad0);
+                goto next;
+            } else if (maxh == opos[0] && dx < 0.0f) {
+                ltp0 = updownleaf(stree, maxh - 1, maxv, &quad0);
+                goto next;
+            } else if ((signed short)minh <= opos[0] && opos[0] <= maxh) {
+                ltp0 = updownleaf(stree, SHOT_FLOOR(opos[0]), maxv, &quad0);
+            }
+        }
+next:
+        ipos[0] = opos[0]; ipos[1] = opos[1]; ipos[2] = opos[2];
+    } while (ltp0);
+    return 0;
+}
